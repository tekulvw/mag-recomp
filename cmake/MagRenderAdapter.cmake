# Opt-in game render adapter: the adapter crates linked with the native frontend, plus the bridges
# the observer hooks in a prepared lift call (tools/render_hooks, docs/render-frontend.md).
# Every option defaults to OFF. With MAG_RENDER_ADAPTER off this file defines options only: no
# file is read, no source, definition or library is added and receipts are unchanged.
option(MAG_RENDER_ADAPTER "Link the game render adapter and its configuration lifetime hooks" OFF)
option(MAG_RENDER_ADAPTER_SHADOW_VIEW "Also observe the Shadow view-corner helper" OFF)
option(MAG_RENDER_ADAPTER_COHORT "Also observe retained visibility cohorts" OFF)
option(MAG_RENDER_ADAPTER_UI_HANDOFF "Also hand the native scene off at the pre-UI boundary" OFF)
foreach(_mag_stage SHADOW_VIEW COHORT UI_HANDOFF)
    if(MAG_RENDER_ADAPTER_${_mag_stage} AND NOT MAG_RENDER_ADAPTER)
        message(FATAL_ERROR "MAG_RENDER_ADAPTER_${_mag_stage} requires MAG_RENDER_ADAPTER")
    endif()
endforeach()
if(MAG_RENDER_ADAPTER_UI_HANDOFF AND NOT MAG_RENDER_ADAPTER_COHORT)
    message(FATAL_ERROR "MAG_RENDER_ADAPTER_UI_HANDOFF requires MAG_RENDER_ADAPTER_COHORT")
endif()
if(MAG_RENDER_ADAPTER AND NOT MAG_RENDER_FRONTEND_NATIVE)
    message(FATAL_ERROR "MAG_RENDER_ADAPTER requires MAG_RENDER_FRONTEND_NATIVE")
endif()

# Check the prepared lift, add the hook bridges and compile guards, and return the receipt entries
# in MAG_RENDER_ADAPTER_RECEIPT_EXTRA. Called by mag_enable_render_frontend.
function(mag_render_adapter_apply target root)
    if(NOT MAG_IMAGE STREQUAL "mage_g")
        message(FATAL_ERROR "MAG_RENDER_ADAPTER applies only to the mage_g engine image")
    endif()
    set(_stages configuration)
    set(_definitions MAG_RENDER_ADAPTER_CONFIGURATION=1)
    set(_bridges "${root}/src/render_adapter")
    set(_sources "${_bridges}/mag_render_frontend_bridge.cpp")
    if(MAG_RENDER_ADAPTER_SHADOW_VIEW)
        list(APPEND _stages shadow-view)
        list(APPEND _definitions MAG_RENDER_ADAPTER_SHADOW_VIEW=1)
    endif()
    if(MAG_RENDER_ADAPTER_COHORT)
        # Located guest reads need the runtime's checked located-range query.
        set(_gcm "${PS3RECOMP_DIR}/libs/video/cellGcmSys.h")
        set(_located "")
        if(EXISTS "${_gcm}")
            file(STRINGS "${_gcm}" _located REGEX "cellGcmNativeReadLocatedRange")
        endif()
        if(NOT _located)
            message(FATAL_ERROR "MAG_RENDER_ADAPTER_COHORT needs cellGcmNativeReadLocatedRange in "
                "libs/video/cellGcmSys.h, which the ps3recomp runtime at ${PS3RECOMP_DIR} does not declare.")
        endif()
        list(APPEND _stages update-loop cohort)
        list(APPEND _definitions MAG_RENDER_ADAPTER_UPDATE_LOOP=1 MAG_RENDER_ADAPTER_COHORT=1)
        list(APPEND _sources "${_bridges}/mag_render_update_loop.cpp" "${_bridges}/mag_render_cohort_bridge.cpp"
            "${_bridges}/mag_render_texture_bridge.cpp")
    endif()
    if(MAG_RENDER_ADAPTER_UI_HANDOFF AND NOT EXISTS "${PS3RECOMP_DIR}/libs/video/rsx_native_handoff.h")
        message(FATAL_ERROR "MAG_RENDER_ADAPTER_UI_HANDOFF needs libs/video/rsx_native_handoff.h, which the "
            "ps3recomp runtime at ${PS3RECOMP_DIR} does not have. The runtime pinned in profiles/framework.json "
            "does not provide it yet.")
    endif()
    if(MAG_RENDER_ADAPTER_UI_HANDOFF)
        message(FATAL_ERROR "MAG_RENDER_ADAPTER_UI_HANDOFF: its hook bridge is not in this repository yet")
    endif()

    # The lift must have been prepared with every enabled stage by the current hook tools.
    set(_provenance "${RECOMP_DIR}/provenance.json")
    set(_prepare "tools/render_hooks/prepare.py --base <lift> --output <new directory>")
    foreach(_stage IN LISTS _stages)
        string(APPEND _prepare " --stage ${_stage}")
    endforeach()
    set(_record "{}")
    if(EXISTS "${_provenance}")
        file(READ "${_provenance}" _record)
    endif()
    string(JSON _hooks ERROR_VARIABLE _error GET "${_record}" render_adapter_hooks)
    if(_error)
        message(FATAL_ERROR "MAG_RENDER_ADAPTER needs a lift prepared with the render hooks. RECOMP_DIR has none; run\n  ${_prepare}\nand point RECOMP_DIR at the output.")
    endif()
    string(JSON _schema ERROR_VARIABLE _error GET "${_hooks}" schema_version)
    if(_error OR NOT _schema EQUAL 1)
        message(FATAL_ERROR "RECOMP_DIR render hook record has an unsupported schema; prepare the lift again")
    endif()
    string(JSON _count LENGTH "${_hooks}" stages)
    set(_prepared "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _stage GET "${_hooks}" stages ${_index})
            list(APPEND _prepared "${_stage}")
        endforeach()
    endif()
    foreach(_stage IN LISTS _stages)
        if(NOT _stage IN_LIST _prepared)
            message(FATAL_ERROR "RECOMP_DIR was prepared without the ${_stage} render hook stage; run\n  ${_prepare}")
        endif()
    endforeach()
    file(GLOB _tools RELATIVE "${root}" CONFIGURE_DEPENDS "${root}/tools/render_hooks/*.py")
    list(SORT _tools)
    string(JSON _count LENGTH "${_hooks}" tools)
    set(_recorded "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _tool MEMBER "${_hooks}" tools ${_index})
            string(JSON _expected GET "${_hooks}" tools "${_tool}")
            if(NOT EXISTS "${root}/${_tool}")
                message(FATAL_ERROR "RECOMP_DIR was prepared by render hook tools that no longer exist; prepare it again")
            endif()
            file(SHA256 "${root}/${_tool}" _actual)
            if(NOT _actual STREQUAL _expected)
                message(FATAL_ERROR "RECOMP_DIR was prepared by a different ${_tool}; prepare it again")
            endif()
            list(APPEND _recorded "${_tool}")
        endforeach()
    endif()
    list(SORT _recorded)
    if(NOT _recorded STREQUAL _tools)
        message(FATAL_ERROR "RECOMP_DIR was prepared by a different set of render hook tools; prepare it again")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_provenance}")

    # Only the rewritten lifted files see the bridge headers and the stage guards, so the other
    # generated translation units keep their compile commands.
    string(JSON _count LENGTH "${_hooks}" changed_outputs)
    set(_changed "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _name GET "${_hooks}" changed_outputs ${_index})
            list(APPEND _changed "${RECOMP_DIR}/${_name}")
        endforeach()
    endif()
    if(_changed)
        set_property(SOURCE ${_changed} APPEND PROPERTY INCLUDE_DIRECTORIES "${_bridges}")
        set_property(SOURCE ${_changed} APPEND PROPERTY COMPILE_DEFINITIONS ${_definitions})
    endif()
    target_sources(${target} PRIVATE ${_sources})
    set_source_files_properties(${_sources} PROPERTIES
        INCLUDE_DIRECTORIES "${RECOMP_DIR};${PS3RECOMP_DIR}/runtime;${PS3RECOMP_DIR};${PS3RECOMP_DIR}/include;${_bridges}"
        COMPILE_DEFINITIONS "${_definitions}")

    set(_receipt "render-adapter-bridges=${_bridges}")
    foreach(_tool IN LISTS _tools)
        get_filename_component(_stem "${_tool}" NAME_WE)
        list(APPEND _receipt "render-adapter-hooks-${_stem}=${root}/${_tool}")
    endforeach()
    set(MAG_RENDER_ADAPTER_RECEIPT_EXTRA ${_receipt} PARENT_SCOPE)
endfunction()
